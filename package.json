{
	"name": "@janiscommerce/app-check-updates",
	"version": "3.6.1",
	"license": "ISC",
	"scripts": {
		"android": "react-native run-android",
		"ios": "react-native run-ios",
		"start": "react-native start",
		"lint": "eslint .",
		"test": "jest",
		"prepare": "husky install",
		"validate:code": "npm run lint -- --fix && tsc --noEmit && npm t",
		"test:commit": "jest --colors --bail --findRelatedTests",
		"test:coverage": "tsc --noEmit && jest --collectCoverage",
		"build": "rm -rf dist && tsc -p tsconfig.build.json"
	},
	"main": "dist/index.js",
	"typings": "dist/index.d.ts",
	"files": [
		"dist",
		"android",
		"react-native.config.js"
	],
	"lint-staged": {
		"*{js,jsx,ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{js,jsx,ts,tsx}": [
			"npm run test:commit"
		]
	},
	"peerDependencies": {
		"@janiscommerce/app-crashlytics": ">=2.1.0",
		"@janiscommerce/app-device-info": ">=1.4.0",
		"@janiscommerce/app-storage": ">=1.3.0",
		"@janiscommerce/ui-native": ">=2.5.0",
		"react": ">=17.0.2 <20.0.0",
		"react-native": ">=0.71.5 <0.82.0",
		"react-native-fs": ">=2.20.0",
		"sp-react-native-in-app-updates": ">=1.2.0"
	},
	"devDependencies": {
		"@babel/core": "^7.12.9",
		"@babel/preset-env": "^7.22.7",
		"@babel/runtime": "^7.12.5",
		"@janiscommerce/app-crashlytics": "3.1.0",
		"@janiscommerce/app-storage": "^1.4.0",
		"@janiscommerce/ui-native": "^2.8.0",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/eslint-config": "^2.0.0",
		"@react-native/babel-preset": "0.80.3",
		"@types/jest": "^29.5.3",
		"@types/node": "^20.5.7",
		"@types/react": "^19.1.0",
		"@types/react-test-renderer": "^19.1.0",
		"babel-jest": "^29.6.3",
		"eslint": "7.14.0",
		"husky": "^7.0.4",
		"jest": "^29.6.3",
		"lint-staged": "^13.2.3",
		"react": "19.1.0",
		"react-native": "0.80.3",
		"react-native-date-picker": "5.0.13",
		"react-native-fast-image": "8.7.0",
		"react-native-fs": "^2.20.0",
		"react-native-gesture-handler": "2.31.2",
		"react-native-mmkv": "^2.12.2",
		"react-native-reanimated": "3.19.5",
		"react-native-safe-area-context": "5.7.0",
		"react-native-svg": "15.8.0",
		"react-native-toast-message": "2.3.3",
		"react-test-renderer": "19.1.0",
		"sp-react-native-in-app-updates": "^1.5.0",
		"typescript": "^5.1.6"
	},
	"overrides": {
		"@janiscommerce/oauth-native": "3.0.0"
	}
}
